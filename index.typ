]
#Skylighting(([#CommentTok("# RSE ");],
[#FunctionTok("summary");#NormalTok("(m_logistic)");#SpecialCharTok("$");#NormalTok("sigma");],));
#block[
#Skylighting(([#NormalTok("[1] 0.4523616");],));
