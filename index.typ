[#NormalTok("              ");#StringTok("`");#AttributeTok("Bias coefficient");#StringTok("`");#NormalTok(" ");#OtherTok("=");#NormalTok(" ");#FunctionTok("epi.ccc");#NormalTok("(measurement, actual)");#SpecialCharTok("$");#NormalTok("C.b,");],
