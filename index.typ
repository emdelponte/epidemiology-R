[#NormalTok("data_train ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("training");#NormalTok("(data_split)");],
[#NormalTok("data_test ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("testing");#NormalTok("(data_split)");],));
