#Skylighting(([#NormalTok("gamma10 ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("rgamma");#NormalTok("(");#AttributeTok("n =");#NormalTok(" ");#DecValTok("100");#NormalTok(", ");#AttributeTok("shape =");#NormalTok(" ");#DecValTok("10");#NormalTok(", ");#AttributeTok("scale =");#NormalTok(" ");#DecValTok("1");#NormalTok(")");],
