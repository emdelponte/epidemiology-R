#Skylighting(([#NormalTok("budblight ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("read_csv");#NormalTok("(");#StringTok("\"https://raw.githubusercontent.com/emdelponte/epidemiology-R/main/data/bud-blight-soybean.csv\"");#NormalTok(")");],));
]
