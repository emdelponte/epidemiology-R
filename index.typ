[#NormalTok("    all_layers ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("c");#NormalTok("(r, ndvi, ndre, cire, sipi, mndvi)");],
[#NormalTok("    ");#FunctionTok("global");#NormalTok("(all_layers, ");#AttributeTok("fun =");#NormalTok(" ");#StringTok("\"mean\"");#NormalTok(", ");#AttributeTok("na.rm =");#NormalTok(" ");#ConstantTok("TRUE");#NormalTok(")[, ");#DecValTok("1");#NormalTok("]");],
[#NormalTok("  })");],
[],
