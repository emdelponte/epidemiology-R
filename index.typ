We now need to obtain the wet period (let's call it leaf wetness, or LW) based on hours of relative humidity \>90% and then the average temperature during the LW period for each day. We can obtain these by grouping the variables by year, month and day and use #NormalTok("mutate()"); and #NormalTok("summarise()");.

#block[
#Skylighting(([#FunctionTok("library");#NormalTok("(tidyverse)");],
[#NormalTok("weather2 ");#OtherTok("<-");#NormalTok(" weather ");#SpecialCharTok("|>");#NormalTok(" ");],
[#NormalTok("      ");#FunctionTok("group_by");#NormalTok("(YEAR, MO, DY) ");#SpecialCharTok("|>");#NormalTok(" ");],
[#NormalTok("      ");#FunctionTok("mutate");#NormalTok("(");#AttributeTok("LW =");#NormalTok(" ");#FunctionTok("case_when");#NormalTok("(RH2M ");#SpecialCharTok(">");#NormalTok(" ");#DecValTok("90");#NormalTok(" ");#SpecialCharTok("~");#NormalTok(" ");#DecValTok("1");#NormalTok(",");],
[#NormalTok("                            ");#ConstantTok("TRUE");#NormalTok(" ");#SpecialCharTok("~");#NormalTok(" ");#DecValTok("0");#NormalTok(")) ");#SpecialCharTok("|>");#NormalTok(" ");],
[#NormalTok("      ");#FunctionTok("filter");#NormalTok("(LW ");#SpecialCharTok(">");#NormalTok(" ");#DecValTok("0");#NormalTok(") ");#SpecialCharTok("|>");],
[#NormalTok("      ");#FunctionTok("summarise");#NormalTok("(");#AttributeTok("Air_LWD =");#NormalTok(" ");#FunctionTok("mean");#NormalTok("(T2M, ");#AttributeTok("na.rm =");#NormalTok(" ");#ConstantTok("TRUE");#NormalTok("),");],
[#NormalTok("                ");#AttributeTok("LWD =");#NormalTok(" ");#FunctionTok("n");#NormalTok("())");],));
]
