[#NormalTok("    ");#FunctionTok("return");#NormalTok("(");#DecValTok("0");#NormalTok(")");],
[#NormalTok("  } ");#ControlFlowTok("else");#NormalTok(" {");],
[#NormalTok("    ((Tmax ");#SpecialCharTok("-");#NormalTok(" T) ");#SpecialCharTok("/");#NormalTok(" (Tmax ");#SpecialCharTok("-");#NormalTok(" Topt)) ");#SpecialCharTok("*");#NormalTok(" ");],
[#NormalTok("    ((T ");#SpecialCharTok("-");#NormalTok(" Tmin) ");#SpecialCharTok("/");#NormalTok(" (Topt ");#SpecialCharTok("-");#NormalTok(" Tmin))");#SpecialCharTok("^");#NormalTok("((Topt ");#SpecialCharTok("-");#NormalTok(" Tmin) ");#SpecialCharTok("/");#NormalTok(" (Tmax ");#SpecialCharTok("-");#NormalTok(" Topt))");],
