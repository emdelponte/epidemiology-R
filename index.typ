#Skylighting(([#FunctionTok("library");#NormalTok("(nasapower)");],
[#NormalTok("weather ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("get_power");#NormalTok("(");],
[#NormalTok("      ");#AttributeTok("community =");#NormalTok(" ");#StringTok("\"ag\"");#NormalTok(",");],
[#NormalTok("      ");#AttributeTok("lonlat =");#NormalTok(" ");#FunctionTok("c");#NormalTok("(");#SpecialCharTok("-");#FloatTok("42.88");#NormalTok(", ");#SpecialCharTok("-");#FloatTok("20.7561");#NormalTok("),");],
[#NormalTok("      ");#AttributeTok("pars =");#NormalTok(" ");#FunctionTok("c");#NormalTok("(");#StringTok("\"RH2M\"");#NormalTok(", ");#StringTok("\"T2M\"");#NormalTok("),");],
[#NormalTok("      ");#AttributeTok("dates =");#NormalTok(" ");#FunctionTok("c");#NormalTok("(");#StringTok("\"2022-03-02\"");#NormalTok(", ");#StringTok("\"2022-03-31\"");#NormalTok("),");],
[#NormalTok("      ");#AttributeTok("temporal_api =");#NormalTok(" ");#StringTok("\"hourly\"");],
[#NormalTok("    )");],
[#FunctionTok("head");#NormalTok("(weather)");],));
#block[
#Skylighting(([#NormalTok("────────────────────────────────────────────────────────────────────────────────");],));
]
#block[
#Skylighting(([#NormalTok("────────────────────────────────────────────────────────────────────────────────");],));
]
#block[
#Skylighting(([#NormalTok("────────────────────────────────────────────────────────────────────────────────");],
[#NormalTok("# A tibble: 6 × 8");],
[#NormalTok("    LON   LAT  YEAR    MO    DY    HR  RH2M   T2M");],
