=== Preparing a set of spectral covariables per plot & date
<preparing-a-set-of-spectral-covariables-per-plot-date>
The 2021 data collection dates are 20210707, 20210715, 20210720, 20210802,and 20210825.

We will write a function that processes all the plot images of one date. For each image, the function reads the five bands, clamps the reflectance values to the range 0 to 1, computes several vegetation indices (VIs), and obtains the average value of the original bands and of the VIs. The results for all plots of the date are returned as a data frame with one row per plot.

#block[
#Skylighting(([#NormalTok("process_date ");#OtherTok("<-");#NormalTok(" ");#ControlFlowTok("function");#NormalTok("(date_string) {");],
[#NormalTok("  ");#CommentTok("# all plot images collected on the given date");],
[#NormalTok("  pattern ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("paste0");#NormalTok("(");#StringTok("\"*_r\"");#NormalTok(", ");#FunctionTok("format");#NormalTok("(");#FunctionTok("as.Date");#NormalTok("(date_string), ");#StringTok("\"%Y%m%d\"");#NormalTok("), ");#StringTok("\".tif\"");#NormalTok(")");],
[#NormalTok("  files ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("Sys.glob");#NormalTok("(");#FunctionTok("file.path");#NormalTok("(");#StringTok("\"data/cercospora_data/multispec_2021_2022\"");#NormalTok(", pattern))");],
[],
[#NormalTok("  ");#CommentTok("# plot number taken from the file name (files are sorted as text)");],
[#NormalTok("  plot_id ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("as.integer");#NormalTok("(");#FunctionTok("sub");#NormalTok("(");#StringTok("\"_.*\"");#NormalTok(", ");#StringTok("\"\"");#NormalTok(", ");#FunctionTok("basename");#NormalTok("(files)))");],
[],
[#NormalTok("  means ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("lapply");#NormalTok("(files, ");#ControlFlowTok("function");#NormalTok("(file) {");],
[#NormalTok("    r ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("clamp");#NormalTok("(");#FunctionTok("rast");#NormalTok("(file), ");#DecValTok("0");#NormalTok(", ");#DecValTok("1");#NormalTok(")");],
[#NormalTok("    ndvi ");#OtherTok("<-");#NormalTok(" (r[[");#DecValTok("5");#NormalTok("]] ");#SpecialCharTok("-");#NormalTok(" r[[");#DecValTok("3");#NormalTok("]]) ");#SpecialCharTok("/");#NormalTok(" (r[[");#DecValTok("5");#NormalTok("]] ");#SpecialCharTok("+");#NormalTok(" r[[");#DecValTok("3");#NormalTok("]])");],
[#NormalTok("    ndre ");#OtherTok("<-");#NormalTok(" (r[[");#DecValTok("5");#NormalTok("]] ");#SpecialCharTok("-");#NormalTok(" r[[");#DecValTok("4");#NormalTok("]]) ");#SpecialCharTok("/");#NormalTok(" (r[[");#DecValTok("5");#NormalTok("]] ");#SpecialCharTok("+");#NormalTok(" r[[");#DecValTok("4");#NormalTok("]])");],
[#NormalTok("    cire ");#OtherTok("<-");#NormalTok(" (r[[");#DecValTok("5");#NormalTok("]] ");#SpecialCharTok("/");#NormalTok(" r[[");#DecValTok("4");#NormalTok("]]) ");#SpecialCharTok("-");#NormalTok(" ");#DecValTok("1");],
[#NormalTok("    sipi ");#OtherTok("<-");#NormalTok(" (r[[");#DecValTok("5");#NormalTok("]] ");#SpecialCharTok("-");#NormalTok(" r[[");#DecValTok("1");#NormalTok("]]) ");#SpecialCharTok("/");#NormalTok(" (r[[");#DecValTok("5");#NormalTok("]] ");#SpecialCharTok("-");#NormalTok(" r[[");#DecValTok("3");#NormalTok("]])");],
[#NormalTok("    ndvi_range ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("minmax");#NormalTok("(ndvi)");],
[#NormalTok("    ndvi_mean ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("global");#NormalTok("(ndvi, ");#AttributeTok("fun =");#NormalTok(" ");#StringTok("\"mean\"");#NormalTok(", ");#AttributeTok("na.rm =");#NormalTok(" ");#ConstantTok("TRUE");#NormalTok(")[, ");#DecValTok("1");#NormalTok("]");],
