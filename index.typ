Then, we can generate the plot using #emph[ggplot].

#Skylighting(([#NormalTok("df_correl ");#SpecialCharTok("|>");],
[#NormalTok("  ");#FunctionTok("ggplot");#NormalTok("(");#FunctionTok("aes");#NormalTok("(lag, X1)) ");#SpecialCharTok("+");],
[#NormalTok("  ");#FunctionTok("geom_col");#NormalTok("(");#AttributeTok("fill =");#NormalTok(" ");#StringTok("\"darkred\"");#NormalTok(") ");#SpecialCharTok("+");],
[#NormalTok("  ");#FunctionTok("theme_r4pde");#NormalTok("()");#SpecialCharTok("+");],
