[#NormalTok(" 1     1     0 0.25   0.9   4.58  8.75  21      NA  2021");],
[#NormalTok(" 2     2     0 0.75   3.68 12.4  20.8   45.4    NA  2021");],
[#NormalTok(" 3     3     0 2.92   7.38 18    34.6   65.2    NA  2021");],
[#NormalTok(" 4     4     0 0.75   5.45 17.4  42.6   75.5    NA  2021");],
[#NormalTok(" 5     5     0 3.38   3.45 15.4  17.2   55.2    NA  2021");],
[#NormalTok(" 6     6     0 0.8    1.38  8.8  12.2   15.4    NA  2021");],
[#NormalTok(" 7     7     0 0.375  3.05  9.1  13     31.0    NA  2021");],
[#NormalTok(" 8     8     0 3.7    8.4  29.4  41.2   71.8    NA  2021");],
[#NormalTok(" 9     9     0 2.38   4.28 13.2  15.6   38.1    NA  2021");],
[#NormalTok("10    10     0 2.22   2.28 30.2  17.3   68      NA  2021");],
[#NormalTok("# ℹ 126 more rows");],));
