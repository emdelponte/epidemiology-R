#Skylighting(([#NormalTok("oring_envelope ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("envelope");#NormalTok("(ppp_aggr, ");#AttributeTok("fun =");#NormalTok(" estimate_o_ring, ");#AttributeTok("nsim =");#NormalTok(" ");#DecValTok("199");#NormalTok(", ");#AttributeTok("verbose =");#NormalTok(" ");#ConstantTok("FALSE");#NormalTok(")");],
