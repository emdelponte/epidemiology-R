[#NormalTok("  ");#FunctionTok("geom_line");#NormalTok("() ");#SpecialCharTok("+");],
[#NormalTok("  ");#FunctionTok("facet_wrap");#NormalTok("(");#SpecialCharTok("~");#NormalTok(" model) ");#SpecialCharTok("+");],
[#NormalTok("  ");#FunctionTok("scale_color_grey");#NormalTok("()");#SpecialCharTok("+");],
[#NormalTok("  ");#FunctionTok("theme_r4pde");#NormalTok("()");#SpecialCharTok("+");],
[#NormalTok("  ");#FunctionTok("theme");#NormalTok("(");#AttributeTok("legend.position =");#NormalTok(" ");#StringTok("\"bottom\"");#NormalTok(")");#SpecialCharTok("+");],
[#NormalTok(" ");#FunctionTok("coord_cartesian");#NormalTok("(");#AttributeTok("ylim =");#NormalTok(" ");#FunctionTok("c");#NormalTok("(");#DecValTok("0");#NormalTok(", ");#DecValTok("1");#NormalTok(")) ");#SpecialCharTok("+");#NormalTok(" ");#CommentTok("# set the max to 0.6");],
[#NormalTok("  ");#FunctionTok("labs");#NormalTok("(");],
[#NormalTok("    ");#AttributeTok("shape =");#NormalTok(" ");#StringTok("\"Epidemic\"");#NormalTok(",");],
[#NormalTok("    ");#AttributeTok("y =");#NormalTok(" ");#StringTok("\"Disease incidence\"");#NormalTok(",");],
