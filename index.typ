#Skylighting(([#FunctionTok("plot_quantums");#NormalTok("(oring_envelope, ");#AttributeTok("ylab =");#NormalTok(" ");#StringTok("\"O-ring\"");#NormalTok(")");#SpecialCharTok("+");],
