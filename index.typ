[#NormalTok("negbin50");#FloatTok(".6");#NormalTok(" ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("rnbinom");#NormalTok("(");#AttributeTok("n =");#NormalTok(" ");#DecValTok("100");#NormalTok(", ");#AttributeTok("size =");#NormalTok(" ");#DecValTok("50");#NormalTok(", ");#AttributeTok("prob =");#NormalTok(" ");#FloatTok("0.6");#NormalTok(")");],
