]
Note that the covar.2021 object has a date attribute in a single column and that the cls object has different columns represent dates (i.e.~D0 to D5). This means that we need to change the #emph[cls] object structure to be able to join its attributes to the #emph[covar.2021] object. In technical terms, our task is to convert the cls table from #emph[wide] format into #emph[long] format.

We will use the #emph[pivot\_longer] function from the #emph[tidyr] package:

#block[
#Skylighting(([#NormalTok("cls ");#SpecialCharTok("|>");],
[#NormalTok("  ");#FunctionTok("pivot_longer");#NormalTok("(");],
[#NormalTok("    ");#AttributeTok("cols =");#NormalTok(" ");#FunctionTok("starts_with");#NormalTok("(");#StringTok("\"D\"");#NormalTok("),");],
[#NormalTok("    ");#AttributeTok("names_to =");#NormalTok(" ");#StringTok("\"date\"");#NormalTok(",");],
[#NormalTok("    ");#AttributeTok("values_to =");#NormalTok(" ");#StringTok("\"severity\"");#NormalTok(",");],
[#NormalTok("    ");#AttributeTok("values_drop_na =");#NormalTok(" ");#ConstantTok("TRUE");],
[#NormalTok("  ) ");#OtherTok("->");#NormalTok(" long_cls");],));
]
Now, we will do an additional step, we will replace qualitative date values (D0, D1, …) for actual date values.

#block[
#Skylighting(([#NormalTok("change ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("tibble");#NormalTok("(");#AttributeTok("old =");#NormalTok(" ");#FunctionTok("c");#NormalTok("(");#StringTok("\"D0\"");#NormalTok(", ");#StringTok("\"D1\"");#NormalTok(", ");#StringTok("\"D2\"");#NormalTok(", ");#StringTok("\"D3\"");#NormalTok(", ");#StringTok("\"D4\"");#NormalTok("),");],
[#NormalTok("                 ");#AttributeTok("new =");#NormalTok(" ");#FunctionTok("c");#NormalTok("(");#StringTok("\"2021-07-07\"");#NormalTok(", ");#StringTok("\"2021-07-15\"");#NormalTok(", ");#StringTok("\"2021-07-20\"");#NormalTok(",");],
[#NormalTok("                          ");#StringTok("\"2021-08-02\"");#NormalTok(",");#StringTok("\"2021-08-25\"");#NormalTok("))");],));
]
Let's check what we got:

#block[
#Skylighting(([#NormalTok("change");],));
#block[
#Skylighting(([#NormalTok("# A tibble: 5 × 2");],
[#NormalTok("  old   new       ");],
[#NormalTok("  <chr> <chr>     ");],
[#NormalTok("1 D0    2021-07-07");],
[#NormalTok("2 D1    2021-07-15");],
[#NormalTok("3 D2    2021-07-20");],
[#NormalTok("4 D3    2021-08-02");],
[#NormalTok("5 D4    2021-08-25");],));
]
]
Now, let's do a left join to produce the changes:

#block[
#Skylighting(([#NormalTok("(ncls ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("left_join");#NormalTok("(long_cls, change, ");#AttributeTok("by =");#NormalTok(" ");#FunctionTok("c");#NormalTok("(");#AttributeTok("date =");#NormalTok(" ");#StringTok("\"old\"");#NormalTok(")))");],));
#block[
#Skylighting(([#NormalTok("# A tibble: 872 × 5");],
[#NormalTok("    Plot  year date  severity new       ");],
[#NormalTok("   <dbl> <dbl> <chr>    <dbl> <chr>     ");],
[#NormalTok(" 1     1  2021 D0        0    2021-07-07");],
[#NormalTok(" 2     1  2021 D1        0.25 2021-07-15");],
