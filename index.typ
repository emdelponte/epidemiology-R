[#NormalTok("c ");#OtherTok("<-");#NormalTok(" fit_temp");#SpecialCharTok("$");#NormalTok("m");#SpecialCharTok("$");#FunctionTok("getAllPars");#NormalTok("()[");#DecValTok("3");#NormalTok("]");],
[#NormalTok("d ");#OtherTok("<-");#NormalTok(" fit_temp");#SpecialCharTok("$");#NormalTok("m");#SpecialCharTok("$");#FunctionTok("getAllPars");#NormalTok("()[");#DecValTok("4");#NormalTok("]");],
