[#NormalTok("  ");#FunctionTok("geom_point");#NormalTok("(");#AttributeTok("data =");#NormalTok(" wet, ");#FunctionTok("aes");#NormalTok("(x, y)) ");#SpecialCharTok("+");],
[#NormalTok("  ");#FunctionTok("theme_r4pde");#NormalTok("(");#AttributeTok("font_size =");#NormalTok(" ");#DecValTok("16");#NormalTok(") ");#SpecialCharTok("+");],
