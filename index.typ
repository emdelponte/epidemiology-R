  [50 - 100], [6],
)
]
#block[
#Skylighting(([#NormalTok("fcovar");#FloatTok(".2021");#NormalTok(" ");#OtherTok("<-");#NormalTok(" ncovar");#FloatTok(".2021");#NormalTok(" ");#SpecialCharTok("|>");#NormalTok(" ");#FunctionTok("mutate");#NormalTok("(");#AttributeTok("category=");#FunctionTok("cut");#NormalTok("(severity, ");#AttributeTok("breaks=");#FunctionTok("c");#NormalTok("(");#DecValTok("0");#NormalTok(",");#DecValTok("1");#NormalTok(",  ");#DecValTok("10");#NormalTok(", ");#DecValTok("20");#NormalTok(", ");#DecValTok("30");#NormalTok(",");#DecValTok("40");#NormalTok(", ");#DecValTok("50");#NormalTok(", ");#DecValTok("100");#NormalTok("), ");#AttributeTok("labels=");#FunctionTok("c");#NormalTok("(");#DecValTok("0");#NormalTok(",");#DecValTok("1");#NormalTok(",");#DecValTok("2");#NormalTok(",");#DecValTok("3");#NormalTok(",");#DecValTok("4");#NormalTok(",");#DecValTok("5");#NormalTok(",");#DecValTok("6");#NormalTok("), ");#AttributeTok("include.lowest =");#NormalTok(" ");#ConstantTok("TRUE");#NormalTok("))");],));
