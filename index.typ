[#NormalTok("matrix2 ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("matrix");#NormalTok("(m2, ");#DecValTok("5");#NormalTok(", ");#DecValTok("5");#NormalTok(", ");#AttributeTok("byrow =");#NormalTok(" ");#ConstantTok("TRUE");#NormalTok(")");],
[],
[#FunctionTok("join_count");#NormalTok("(matrix2)");],));
