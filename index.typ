[#NormalTok("             ");#AttributeTok("control =");#NormalTok(" ");#FunctionTok("list");#NormalTok("(");#AttributeTok("parscale =");#NormalTok(" ");#FloatTok("1e-5");#NormalTok(")) ");#CommentTok("# note need last argument to ");],
[#NormalTok("                                              ");#CommentTok("# avoid optimiser thinking it has");],
[#NormalTok("                                              ");#CommentTok("# converged when it has not ");],
[#NormalTok("                                              ");#CommentTok("# (due to large values of SS)");],
[],
[#NormalTok("beta.hat ");#OtherTok("<-");#NormalTok(" fit");#SpecialCharTok("$");#NormalTok("par");],
[],
[#FunctionTok("print");#NormalTok("(");#FunctionTok("paste");#NormalTok("(");#StringTok("\"Estimated beta (optim) =\"");#NormalTok(", beta.hat))");],));
#block[
#Skylighting(([#NormalTok("[1] \"Estimated beta (optim) = 1.98176029764102e-05\"");],));
